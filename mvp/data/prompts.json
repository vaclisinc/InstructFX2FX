{
  "experiment_1_A_to_notA": {
    "description": "Test negation understanding",
    "prompts": [
      {
        "attribute": "bright",
        "text_anchor": "this sound is too bright",
        "text_target": "this sound is not bright",
        "expected": "Reduce high frequencies"
      },
      {
        "attribute": "warm",
        "text_anchor": "this sound is too warm",
        "text_target": "this sound is not warm",
        "expected": "Reduce low frequencies"
      },
      {
        "attribute": "harsh",
        "text_anchor": "this sound is too harsh",
        "text_target": "this sound is not harsh",
        "expected": "Reduce mid-high frequencies, smooth out"
      }
    ]
  },
  "experiment_2_notB_to_B": {
    "description": "Test addition and enhancement",
    "prompts": [
      {
        "attribute": "warm",
        "text_anchor": "this sound is not warm",
        "text_target": "this sound is warm",
        "expected": "Boost low frequencies"
      },
      {
        "attribute": "bright",
        "text_anchor": "this sound is not bright",
        "text_target": "this sound is bright",
        "expected": "Boost high frequencies"
      },
      {
        "attribute": "spacious",
        "text_anchor": "this sound is not spacious",
        "text_target": "this sound is spacious",
        "expected": "Add reverb"
      }
    ]
  },
  "experiment_3_A_to_B": {
    "description": "Test bidirectional adjustment",
    "prompts": [
      {
        "from": "harsh",
        "to": "smooth",
        "text_anchor": "this sound is too harsh",
        "text_target": "this sound is smooth",
        "expected": "Reduce harsh frequencies, add smoothness"
      },
      {
        "from": "muddy",
        "to": "clear",
        "text_anchor": "this sound is too muddy",
        "text_target": "this sound is clear",
        "expected": "Cut low-mids, boost clarity"
      },
      {
        "from": "dry",
        "to": "lush",
        "text_anchor": "this sound is too dry",
        "text_target": "this sound is lush",
        "expected": "Add reverb and richness"
      }
    ]
  }
}
