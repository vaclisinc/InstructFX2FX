{
  "description": "bright and energetic electric guitar sound for upbeat rock",
  "effects": [
    {
      "type": "eq",
      "parameters": {
        "bands": [
          {
            "frequency": 100,
            "gain": -2.0,
            "q": 0.8,
            "note": "Reduce low-end mud for clarity"
          },
          {
            "frequency": 800,
            "gain": 2.5,
            "q": 1.5,
            "note": "Boost upper-mids for presence and bite"
          },
          {
            "frequency": 3500,
            "gain": 4.0,
            "q": 1.0,
            "note": "Strong high-mid boost for brightness and edge"
          },
          {
            "frequency": 10000,
            "gain": 3.0,
            "q": 0.7,
            "note": "Enhance sparkle and air for energy"
          }
        ]
      }
    },
    {
      "type": "compressor",
      "parameters": {
        "threshold": -20.0,
        "ratio": 4.5,
        "attack": 3.0,
        "release": 50.0,
        "knee": 3.0,
        "makeup_gain": 6.0,
        "note": "Aggressive compression for sustain and punch"
      }
    },
    {
      "type": "reverb",
      "parameters": {
        "room_size": 0.45,
        "damping": 0.4,
        "wet_level": 0.25,
        "dry_level": 0.9,
        "width": 0.75,
        "freeze_mode": false,
        "note": "Medium room with bright character for energetic space"
      }
    }
  ]
}
