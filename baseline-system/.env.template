# LLM-as-Music-Judge Environment Configuration Template
#
# Copy this file to .env and fill in your actual values:
#   cp .env.template .env
#
# IMPORTANT: Never commit the .env file to version control!
# The .env file is already included in .gitignore

# =============================================================================
# LLM API KEYS (Required - add at least one)
# =============================================================================

# Anthropic Claude API Key (Recommended)
# Get your key at: https://console.anthropic.com/
# Used for Claude-3.5-Sonnet and other Claude models
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter API Key
# Get your key at: https://openrouter.ai/
# Provides access to multiple LLM providers through a unified API
OPENROUTER_API_KEY=sk-or-your-key-here

# OpenAI API Key
# Get your key at: https://platform.openai.com/
# Used for GPT-4 and other OpenAI models
OPENAI_API_KEY=sk-your-key-here

# =============================================================================
# CONFIGURATION SETTINGS (Optional - defaults provided)
# =============================================================================

# Path to configuration file
# Default: configs/default.yaml
# Options: configs/default.yaml, configs/experiment.yaml, or custom path
CONFIG_PATH=configs/default.yaml

# Log level for application logging
# Default: INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
# Default: console (for development)
# Options: console (pretty), json (structured for production)
LOG_FORMAT=console

# Directory for log output
# Default: ./logs
LOG_OUTPUT_DIR=./logs

# =============================================================================
# AUDIO PROCESSING SETTINGS (Optional - defaults provided)
# =============================================================================

# Sample rate for audio processing (Hz)
# Default: 44100
# Common values: 44100 (CD quality), 48000 (professional), 96000 (high-res)
SAMPLE_RATE=44100

# Directory containing audio samples
# Default: ./audio_samples
AUDIO_DIR=./audio_samples

# Maximum audio duration to process (seconds)
# Default: 30.0
MAX_AUDIO_DURATION=30.0

# =============================================================================
# LLM PROVIDER SETTINGS (Optional - defaults provided)
# =============================================================================

# LLM provider to use
# Default: anthropic
# Options: anthropic, openai, openrouter
LLM_PROVIDER=anthropic

# Model identifier/name
# Default: claude-3-5-sonnet-20241022
# Anthropic options: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229
# OpenAI options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# OpenRouter: Check https://openrouter.ai/models for available models
LLM_MODEL=claude-3-5-sonnet-20241022

# Temperature for LLM generation (0.0-2.0)
# Default: 0.7
# Lower = more deterministic, Higher = more creative
# Typical range: 0.3-1.0 for most tasks
LLM_TEMPERATURE=0.7

# Maximum tokens for LLM response
# Default: 4096
# Adjust based on your needs and model limits
LLM_MAX_TOKENS=4096

# =============================================================================
# EXPERIMENT SETTINGS (Optional - defaults provided)
# =============================================================================

# Experiment name
# Used for organizing results and logs
EXPERIMENT_NAME=baseline_experiment

# Dataset to use
# Default: CAL500
# Options: CAL500, MusicCaps, or custom dataset name
EXPERIMENT_DATASET=CAL500

# Batch size for processing
# Default: 8
# Adjust based on available memory
EXPERIMENT_BATCH_SIZE=8

# Number of iterations for iterative refinement
# Default: 5
EXPERIMENT_NUM_ITERATIONS=5

# Directory for experiment results
# Default: ./results
EXPERIMENT_RESULTS_DIR=./results

# =============================================================================
# ADVANCED SETTINGS (Optional - for advanced users)
# =============================================================================

# Enable debug mode (more verbose logging, detailed error traces)
# Default: false
# DEBUG_MODE=true

# Disable API call rate limiting (use with caution)
# Default: false
# DISABLE_RATE_LIMITING=false

# Cache directory for model downloads
# Default: ~/.cache/baseline-system
# MODEL_CACHE_DIR=~/.cache/baseline-system

# Number of worker threads for parallel processing
# Default: 4
# NUM_WORKERS=4

# Timeout for API calls (seconds)
# Default: 60
# API_TIMEOUT=60

# Enable experimental features
# Default: false
# ENABLE_EXPERIMENTAL=false

# =============================================================================
# NOTES
# =============================================================================

# Environment Variable Priority:
# Environment variables override YAML configuration values.
# This allows you to customize settings without modifying config files.
#
# Example:
#   - Set AUDIO_SAMPLE_RATE=48000 to override audio.sample_rate in YAML
#   - Set LOG_LEVEL=DEBUG to override logging.level in YAML
#
# Configuration Hierarchy (highest to lowest priority):
#   1. Environment Variables (this .env file)
#   2. Profile-specific YAML (e.g., configs/experiment.yaml)
#   3. Default YAML (configs/default.yaml)
#   4. Pydantic model defaults
#
# Security Best Practices:
#   - Never commit .env file to version control
#   - Use different .env files for dev/staging/production
#   - Rotate API keys regularly
#   - Use read-only API keys when possible
#   - Keep API keys secure and never share them
#
# Getting API Keys:
#   - Anthropic: https://console.anthropic.com/
#   - OpenRouter: https://openrouter.ai/
#   - OpenAI: https://platform.openai.com/
#
# For more information, see README.md
